# Copy to .env and edit. Placeholders only: never commit real values.
# CALL_PACE_* variables are read by Config.from_env(). DB_* variables are read by the SQL Server loader.

# --- Modelling and serving (all optional, defaults shown) ---
CALL_PACE_ARTIFACTS_DIR=artifacts
CALL_PACE_ARTIFACT_TTL_SECONDS=86400
CALL_PACE_START_HOUR=8
CALL_PACE_END_HOUR=19
CALL_PACE_LOOKUP_WINDOW_DAYS=60
# bucket=days, comma separated: drop the most recent N days of that bucket before fitting
CALL_PACE_MATURITY_CUTOFF_DAYS=
# lookup | knn | quantile
CALL_PACE_DEFAULT_MODEL=knn
# bucket=model, comma separated
CALL_PACE_ROUTING=

# --- SQL Server loader (only needed with --source sqlserver, for any command including serve) ---
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_USER=readonly_user
DB_PASSWORD=change-me
# bucket=database, comma separated
DB_NAMES=auto=agreements_auto,consumer=agreements_consumer
